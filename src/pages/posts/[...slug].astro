---
export async function getStaticPaths() {
  // Eagerly import all markdown posts under src/posts/**
  const modules = import.meta.glob('/src/posts/**/*.md', { eager: true });

  const normalizeKey = (k) => k.replace(/\\/g, '/');
  const toSlugParts = (k) => normalizeKey(k)
    .replace(/^\/?src\/posts\//, '')
    .replace(/\.md$/, '')
    .split('/');

  return Object.keys(modules).map((k) => ({
    params: { slug: toSlugParts(k) },
    props: { key: k },
  }));
}

const { slug } = Astro.params;
const keyFromSlug = (s) => `/src/posts/${(Array.isArray(s) ? s.join('/') : s)}.md`;
const key = keyFromSlug(slug);
const modules = import.meta.glob('/src/posts/**/*.md', { eager: true });
const mod = modules[key];
if (!mod) {
  throw new Error(`Post not found for slug: ${Array.isArray(slug) ? slug.join('/') : slug}`);
}

const { Content, frontmatter } = mod;
import Base from '../../layouts/Base.astro';
---
<Base title={frontmatter.Title}>
  <section id="wrapper">
    <header>
      <div class="inner">
        <h2>{frontmatter.Title}</h2>
        {frontmatter.Published && (<p>Published: {frontmatter.Published}</p>)}
        {Array.isArray(frontmatter.Tags) && frontmatter.Tags.length > 0 && (
          <p>
            Tags:{' '}
            {frontmatter.Tags.map((t, i) => (
              <span>
                <a href={`/tags/${encodeURIComponent(t)}`}>{t}</a>
                {i < frontmatter.Tags.length - 1 ? ', ' : ''}
              </span>
            ))}
          </p>
        )}
      </div>
    </header>
    <div class="wrapper">
      <div class="inner">
        <article class="content">
          <Content />
        </article>
      </div>
    </div>
  </section>
</Base>
