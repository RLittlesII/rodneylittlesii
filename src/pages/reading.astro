---
import Base from '../layouts/Base.astro';
import Reading from '../reading.md';
const { Content, frontmatter } = Reading;
---
<Base title={frontmatter.Title}>
  <section id="wrapper">
    <header>
      <div class="inner">
        <h2>{frontmatter.Title}</h2>
      </div>
    </header>
    <div class="wrapper">
      <div class="inner">
        <Content />
      </div>
    </div>
  </section>
</Base>
