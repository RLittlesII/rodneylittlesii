---
import { site } from '../site';

const year = new Date().getFullYear();
---
<h2>Feeds</h2>
<ul class="actions">
  <li><a href="/feed.rss" class="button small"><i class="fa fa-rss"></i> RSS Feed</a></li>
</ul>
<h5>The Internets</h5>
<ul class="contact">
  {site.social.map((link) => (
    <li><a href={link.href}><i class={`fa ${link.icon}`}></i>{link.label}</a></li>
  ))}
</ul>
<ul class="copyright">
  <li>Copyright Rodney Littles, II &copy; {year}</li>
  <li>Design: <a href="https://html5up.net">HTML5 UP</a></li>
  <li>Generated by <a href="https://astro.build">Astro</a></li>
  <li>Hosted by <a href="https://www.netlify.com">Netlify</a></li>
</ul>
